# Vendored snapshot: these bytes are hash-gated against the upstream wheel
# (VENDORED_FROM.json + tests/test_vendored_provider.py), so git must not
# translate line endings on checkout. Without this, a fresh clone on a machine
# with core.autocrlf=true gets CRLF and the drift gate fails for no real reason.
integrations/hermes-provider/hermes_memory_provider/** -text
integrations/hermes-provider/LICENSE.upstream -text
integrations/hermes-provider/UPSTREAM_METADATA.txt -text

# Engine diffs are byte-hashed; preserve LF and unified-diff blank context markers.
integrations/engine-patches/*.patch text eol=lf whitespace=-blank-at-eol

# Shell scripts should stay LF everywhere (they are executed, not compiled).
*.sh text eol=lf

# Keep the other text formats LF in the worktree too. Without this, a clone on a
# machine with core.autocrlf=true checks out CRLF, so a local lint/format run
# disagrees with CI (shellcheck's SC1017, markdownlint's new-line rule) for no
# real reason. The vendored snapshot above stays exempt.
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.ps1 text eol=lf

# Later patterns win: byte-gated vendor/fixture payloads must override the
# generic text rules above, including future upstream CRLF snapshots.
integrations/hermes-provider/hermes_memory_provider/** -text
tests/fixtures/hermes_main_a28a5d03/LICENSE.upstream -text
