+# LOCAL PATCH: relevance selection is opt-in until a full benchmark tunes it.
+def _apply_recall_score_floor(results: List[Dict]) -> List[Dict]:
+    """Keep results within an opt-in ratio of the best recall score.
+
+    Scores combine different signals and are not calibrated as absolute
+    probabilities. The environment setting is therefore a relative ratio in
+    [0, 1], and remains disabled unless an operator explicitly sets it.
+    """
+    raw_ratio = os.environ.get("MNEMOSYNE_RECALL_SCORE_FLOOR", "0")
+    try:
+        ratio = float(raw_ratio)
+    except (TypeError, ValueError):
+        logger.warning("Ignoring invalid MNEMOSYNE_RECALL_SCORE_FLOOR: %r", raw_ratio)
+        return results
+    if not math.isfinite(ratio) or ratio < 0.0 or ratio > 1.0:
+        logger.warning("Ignoring out-of-range MNEMOSYNE_RECALL_SCORE_FLOOR: %r", raw_ratio)
+        return results
+    if ratio == 0.0 or not results:
+        return results
+
+    scores = [
+        score for row in results
+        if isinstance((score := row.get("score")), (int, float)) and math.isfinite(score)
+    ]
+    if not scores:
+        return results
+    best_score = max(scores)
+    if best_score <= 0.0:
+        return results
+    threshold = best_score * ratio
+    return [
+        row for row in results
+        if isinstance(row.get("score"), (int, float))
+        and math.isfinite(row["score"])
+        and row["score"] >= threshold
+    ]
+
 
