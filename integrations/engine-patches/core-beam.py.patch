+_HIGH_ENTROPY_TOKEN_RE = re.compile(r"(?<![A-Za-z0-9])[A-Za-z0-9+/=]{32,}(?![A-Za-z0-9])")
+_SECRET_LABEL_RE = re.compile(
+    r"\b(?:api[_ -]?key|secret|token|credential|password)\s*[:=]\s*['\"]?"
+    r"([A-Za-z0-9_./+=-]{16,})", re.IGNORECASE
