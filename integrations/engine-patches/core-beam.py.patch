+@contextlib.contextmanager
+def _temporarily_release_db_lock(db_lock):
+    # LOCAL PATCH: yield provider SQLite coordination only for model/embed waits.
+    """Release an already-held provider lock around slow non-SQL work."""
+    if db_lock is None:
+        yield
+        return
+    db_lock.release()
+    try:
+        yield
+    finally:
+        db_lock.acquire()
