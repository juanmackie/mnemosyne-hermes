+def _abstain_on_unknown_identifier(query_tokens: List[str], contents: List[str]) -> bool:
+    """True when the query names an identifier no candidate row contains.
+
+    LOCAL PATCH (`MNEMOSYNE_RECALL_ABSTAIN_IDENTIFIERS`). A query that names a
+    specific identifier (an alphanumeric token such as a host, ticket or asset
+    name) the store has never seen cannot be answered from the store. Returning
+    the nearest rows that merely share topic words is a fabricated answer: the
+    subject does not exist, so every returned row is off-subject by
+    construction. The score dumps show this exactly -- for every unanswerable
+    probe the identifier is absent from all candidates, while every answerable
+    probe has it in the top row.
+
+    Deliberately narrow: digit-bearing tokens and tokens ending in a four-letter
+    hexadecimal suffix qualify. The latter covers opaque lowercase IDs that do
+    not happen to contain a decimal digit; ordinary unknown words are still
+    treated as vocabulary drift unless they have this identifier shape.
+    """
+    haystack = " ".join(contents).lower()
+    anchor_candidates = {
+        token for token in query_tokens
+        if len(token) >= 4 and token not in haystack
+    }
+    if not anchor_candidates:
+        return False
+
+    # A token containing a digit is an identifier outright: a host, ticket or
+    # asset name. That is the narrow, safe test.
+    if any(_IDENTIFIER_RE.match(token) for token in anchor_candidates):
+        return True
+
+    return False
