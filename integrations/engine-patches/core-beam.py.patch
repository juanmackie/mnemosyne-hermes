+def _redact_capture_secrets(content: str) -> str:
+    """Remove recognizable credentials before text reaches persistent storage."""
+    spans = [(match.start(), match.end()) for pattern in (_SECRET_TOKEN_RE, _SECRET_LABEL_RE)
+             for match in pattern.finditer(content)]
+    for match in _HIGH_ENTROPY_TOKEN_RE.finditer(content):
+        token = match.group()
+        entropy = -sum(
+            (count / len(token)) * math.log2(count / len(token))
+            for count in (token.count(char) for char in set(token))
+        )
+        if entropy >= 4.0:
+            spans.append((match.start(), match.end()))
+    spans.sort(key=lambda span: (span[0], -(span[1] - span[0])))
+    selected = []
+    end = -1
+    for start, stop in spans:
+        if start >= end:
+            selected.append((start, stop))
+            end = stop
+    for start, stop in reversed(selected):
+        content = content[:start] + "[REDACTED]" + content[stop:]
+    return content
