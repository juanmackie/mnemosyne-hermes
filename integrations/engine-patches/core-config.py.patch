+def _read_config_text(path: "Path") -> str:
+    """LOCAL PATCH: P35 read config.yaml as UTF-8.
+
+    Older releases wrote it through the locale encoding, so a Windows file can
+    be cp1252. Decode that only when UTF-8 fails, instead of failing outright.
+    """
+    raw = path.read_bytes()
+    try:
+        return raw.decode("utf-8")
+    except UnicodeDecodeError:
+        import locale
+
+        return raw.decode(locale.getpreferredencoding(False) or "utf-8", errors="replace")
+
