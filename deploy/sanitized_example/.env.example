.env.example — sanitized deployment example (no secrets, no real paths)
# This file contains variable names only. Do NOT add real DB paths, binary paths, or keys.
# Contracts preserved: namespace=agent:hermes, provider=mnemosyne-rust (or future mnemosyne)
MNEMOSYNE_BIN=mnemosyne
MNEMOSYNE_MCP_ARGS=mcp
MNEMOSYNE_DB_PATH=
MNEMOSYNE_HERMES_HOME=
MNEMOSYNE_NAMESPACE=agent:hermes
MNEMOSYNE_PROVIDER_ID=mnemosyne-rust
MNEMOSYNE_POLICY_OWNER=mnemosyne-rust
MNEMOSYNE_EXECUTION_CONTEXT=
MNEMOSYNE_REQUEST_TIMEOUT=10
MNEMOSYNE_INITIALIZE_TIMEOUT=15
MNEMOSYNE_PREFETCH_TIMEOUT=3
MNEMOSYNE_SHUTDOWN_TIMEOUT=5
MNEMOSYNE_EAGER_CONNECT=0
