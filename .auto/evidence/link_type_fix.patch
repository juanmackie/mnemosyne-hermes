+    /// Widen `memory_links.link_type` so it accepts every `LinkType` variant.
+    ///
+    /// The shipped CHECK listed five of the eight variants, and every writer uses
+    /// INSERT OR IGNORE, so `builds_upon`, `referenced_by` and `clarifies` edges
+    /// were discarded at store time -- no error, no row, nothing to recover later.
+    ///
+    /// A CHECK cannot be altered in place, so the table is rebuilt from *its own*
+    /// stored DDL with three literals added: columns, defaults, NOT NULL flags,
+    /// foreign keys and the UNIQUE clause survive because they are copied verbatim
+    /// instead of being respecified (a hand-written replacement also silently loses
+    /// `DEFAULT CURRENT_TIMESTAMP`, which turns `created_at` into NULL for every new
+    /// edge). Indexes are recreated from their own stored DDL. A database whose DDL
+    /// does not look like the one this understands is left alone and reported rather
+    /// than rebuilt on a guess.
+    ///
+    /// Caller holds `MIGRATION_LOCK`; runs once per open on an unchanged database.
+    async fn widen_link_type_check(&self, conn: &Connection) -> Result<()> {
+        let mut ddl_rows = conn
+            .query(
+                "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'memory_links'",
+                (),
+            )
+            .await?;
+        let ddl = match ddl_rows.next().await? {
+            Some(row) => row.get::<String>(0).unwrap_or_default(),
+            // No table yet: whichever path creates it uses the widened DDL.
+            None => return Ok(()),
+        };
+        drop(ddl_rows);
+        if ddl.contains("'builds_upon'") {
+            return Ok(());
+        }
+        if !ddl.contains("link_type IN (") || !ddl.contains("'extends'") {
+            warn!(
+                "memory_links does not carry the shipped link_type CHECK;                  leaving its link types unconstrained"
+            );
+            return Ok(());
+        }
+
+        let column_names = Self::table_columns(conn, "memory_links").await?;
+        if column_names.is_empty() {
+            return Ok(());
+        }
+
+        let mut index_rows = conn
+            .query(
+                "SELECT sql FROM sqlite_master \
+                     WHERE type = 'index' AND tbl_name = 'memory_links' AND sql IS NOT NULL",
+                (),
+            )
+            .await?;
+        let mut index_ddls = Vec::new();
+        while let Some(row) = index_rows.next().await? {
+            index_ddls.push(row.get::<String>(0)?);
+        }
+        drop(index_rows);
+
+        // Rename the table in its own DDL, then add the missing variants. Only the
+        // first occurrence is the table name; every later one is inside the body.
+        let at = match ddl.find("memory_links") {
+            Some(at) => at,
+            None => return Ok(()),
+        };
+        let mut renamed = String::with_capacity(ddl.len() + 24);
+        renamed.push_str(&ddl[..at]);
+        renamed.push_str("memory_links_widened");
+        renamed.push_str(&ddl[at + "memory_links".len()..]);
+        let widened = renamed.replace(
+            "'extends',",
+            "'extends', 'builds_upon', 'referenced_by', 'clarifies',",
+        );
+        if widened == renamed {
+            // The CHECK did not contain the literal we key on; nothing safe to do.
+            return Ok(());
+        }
+
+        let column_list = column_names.join(", ");
+        let mut tx = conn.transaction().await?;
+        tx.execute(widened.as_str(), ()).await?;
+        tx.execute(
+            format!(
+                "INSERT INTO memory_links_widened ({}) SELECT {} FROM memory_links",
+                column_list, column_list
+            )
+            .as_str(),
+            (),
+        )
+        .await?;
+        tx.execute("DROP TABLE memory_links", ()).await?;
+        tx.execute(
+            "ALTER TABLE memory_links_widened RENAME TO memory_links",
+            (),
+        )
+        .await?;
+        for index_ddl in &index_ddls {
+            tx.execute(index_ddl.as_str(), ()).await?;
+        }
+        tx.commit().await?;
+
+        let mut preserved = conn.query("SELECT COUNT(*) FROM memory_links", ()).await?;
+        let edges = match preserved.next().await? {
+            Some(row) => row.get::<i64>(0).unwrap_or(0),
+            None => 0,
+        };
+        drop(preserved);
+        info!(
+            "Widened memory_links.link_type to every LinkType variant ({} edges preserved)",
+            edges
+        );
+        Ok(())
+    }
+
+    /// Column names of a table, in declaration order.
+    async fn table_columns(conn: &Connection, table: &str) -> Result<Vec<String>> {
+        let mut rows = conn
+            .query(format!("PRAGMA table_info({})", table).as_str(), ())
+            .await?;
+        let mut columns = Vec::new();
+        while let Some(row) = rows.next().await? {
+            columns.push(row.get::<String>(1)?);
+        }
+        Ok(columns)
+    }
