diff --git a/src/storage/libsql_link_type_tests.rs b/src/storage/libsql_link_type_tests.rs
new file mode 100644
index 0000000..a3d9be2
--- /dev/null
+++ b/src/storage/libsql_link_type_tests.rs
@@ -0,0 +1,301 @@
+//! Link types must agree in exactly one place.
+//!
+//! `LinkType` has eight variants. Until recently the schema CHECK listed five, the
+//! writer used `INSERT OR IGNORE`, and both readers mapped stored type text through
+//! a five-arm match ending in `_ => continue` / `_ => None`. The three variants
+//! missing from those copies (`builds_upon`, `referenced_by`, `clarifies`) produced
+//! no error and no row: graph edges the caller believed it had were never stored.
+//! These tests pin the enum as the only list.
+
+#[cfg(test)]
+mod link_type_tests {
+    use crate::storage::StorageBackend;
+    use crate::types::{LinkType, MemoryClass, MemoryLink, MemoryNote, MemoryType, Namespace};
+    use crate::{ConnectionMode, LibsqlStorage};
+    use chrono::Utc;
+    use libsql::params;
+    use tempfile::TempDir;
+
+    async fn storage() -> (LibsqlStorage, TempDir) {
+        let temp_dir = TempDir::new().unwrap();
+        let db_path = temp_dir.path().join("test_link_types.db");
+        let store = LibsqlStorage::new_with_validation(
+            ConnectionMode::Local(db_path.to_str().unwrap().to_string()),
+            true,
+        )
+        .await
+        .expect("test storage");
+        (store, temp_dir)
+    }
+
+    /// A memory linked to `targets`, once per listed type.
+    fn note_with_links(content: &str, targets: &[MemoryLink]) -> MemoryNote {
+        MemoryNote {
+            id: crate::types::MemoryId::new(),
+            namespace: Namespace::Global,
+            created_at: Utc::now(),
+            updated_at: Utc::now(),
+            content: content.to_string(),
+            summary: content.to_string(),
+            keywords: vec!["links".to_string()],
+            tags: vec!["links".to_string()],
+            context: String::new(),
+            memory_type: MemoryType::Insight,
+            memory_class: MemoryClass::Knowledge,
+            provenance: None,
+            importance: 7,
+            confidence: 0.9,
+            links: targets.to_vec(),
+            related_files: vec![],
+            related_entities: vec![],
+            access_count: 0,
+            last_accessed_at: Utc::now(),
+            expires_at: None,
+            is_archived: false,
+            superseded_by: None,
+            embedding: None,
+            embedding_model: String::new(),
+        }
+    }
+
+    fn link(target: crate::types::MemoryId, link_type: LinkType) -> MemoryLink {
+        MemoryLink {
+            target_id: target,
+            link_type,
+            strength: 0.9,
+            reason: "test".to_string(),
+            created_at: Utc::now(),
+            last_traversed_at: None,
+            user_created: false,
+        }
+    }
+
+    async fn stored_types(store: &LibsqlStorage) -> Vec<String> {
+        let conn = store.get_conn().unwrap();
+        let mut rows = conn
+            .query(
+                "SELECT link_type FROM memory_links ORDER BY link_type",
+                params![],
+            )
+            .await
+            .unwrap();
+        let mut found = Vec::new();
+        while let Some(row) = rows.next().await.unwrap() {
+            found.push(row.get::<String>(0).unwrap());
+        }
+        found
+    }
+
+    async fn scalar_i64(store: &LibsqlStorage, sql: &str) -> i64 {
+        let conn = store.get_conn().unwrap();
+        let mut rows = conn.query(sql, params![]).await.unwrap();
+        rows.next().await.unwrap().unwrap().get::<i64>(0).unwrap()
+    }
+
+    async fn table_ddl(store: &LibsqlStorage) -> String {
+        let conn = store.get_conn().unwrap();
+        let mut rows = conn
+            .query(
+                "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'memory_links'",
+                params![],
+            )
+            .await
+            .unwrap();
+        rows.next()
+            .await
+            .unwrap()
+            .unwrap()
+            .get::<String>(0)
+            .unwrap()
+    }
+
+    /// `as_db_str` / `from_db_str` are inverses, so a value that can be written but
+    /// not read (or the reverse) requires both lists to be wrong identically.
+    #[test]
+    fn link_type_text_round_trips() {
+        let mut texts: Vec<String> = Vec::new();
+        for link_type in LinkType::all() {
+            let text = link_type.as_db_str();
+            assert_eq!(
+                LinkType::from_db_str(text),
+                Some(link_type),
+                "{link_type:?} does not round-trip through '{text}'"
+            );
+            texts.push(text.to_string());
+        }
+        texts.sort();
+        texts.dedup();
+        assert_eq!(
+            texts.len(),
+            LinkType::all().len(),
+            "two variants share one stored text"
+        );
+        assert_eq!(LinkType::from_db_str("nonsense"), None);
+    }
+
+    /// The real writer path: storing a memory carrying one link of every variant.
+    /// `INSERT OR IGNORE` is why this needed a test -- a rejected edge was silent.
+    #[tokio::test]
+    async fn every_link_type_variant_reaches_the_table() {
+        let (store, _tmp) = storage().await;
+        let target_note = note_with_links("link target", &[]);
+        let target = target_note.id.clone();
+        store.store_memory(&target_note).await.unwrap();
+
+        let links: Vec<MemoryLink> = LinkType::all()
+            .iter()
+            .map(|link_type| link(target.clone(), *link_type))
+            .collect();
+        store
+            .store_memory(&note_with_links("link source", &links))
+            .await
+            .unwrap();
+
+        let found = stored_types(&store).await;
+        for link_type in LinkType::all() {
+            let text = link_type.as_db_str();
+            assert!(
+                found.iter().any(|t| t == text),
+                "'{text}' never reached memory_links (found {found:?})"
+            );
+        }
+        for text in &found {
+            assert!(
+                LinkType::from_db_str(text).is_some(),
+                "stored link type '{text}' has no typed reader"
+            );
+        }
+    }
+
+    /// A database whose CHECK predates the fix is repaired on open: rows survive,
+    /// column defaults survive, the illegal type becomes writable, and the repair is
+    /// idempotent.
+    #[tokio::test]
+    async fn repair_widens_an_old_database_and_keeps_rows_and_defaults() {
+        let (store, _tmp) = storage().await;
+        let conn = store.get_conn().unwrap();
+
+        // Recreate the table exactly as it shipped before the fix.
+        conn.execute_batch(
+            "DROP TABLE memory_links;
+             CREATE TABLE memory_links (
+                 id INTEGER PRIMARY KEY AUTOINCREMENT,
+                 source_id TEXT NOT NULL REFERENCES memories(id) ON DELETE CASCADE,
+                 target_id TEXT NOT NULL REFERENCES memories(id) ON DELETE CASCADE,
+                 link_type TEXT NOT NULL CHECK(link_type IN (
+                     'extends',
+                     'contradicts',
+                     'implements',
+                     'references',
+                     'supersedes'
+                 )),
+                 strength REAL NOT NULL DEFAULT 0.5 CHECK(strength >= 0.0 AND strength <= 1.0),
+                 reason TEXT,
+                 created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+                 UNIQUE(source_id, target_id, link_type)
+             );
+             CREATE INDEX idx_links_source ON memory_links(source_id);
+             CREATE INDEX idx_links_target ON memory_links(target_id);",
+        )
+        .await
+        .unwrap();
+
+        let (source, target) = {
+            let mut ids = Vec::new();
+            for content in ["edge source", "edge target"] {
+                let note = note_with_links(content, &[]);
+                ids.push(note.id.clone());
+                store.store_memory(&note).await.unwrap();
+            }
+            (ids[0].clone(), ids[1].clone())
+        };
+
+        // The way the writer writes: an illegal type disappears without an error.
+        conn.execute(
+            "INSERT OR IGNORE INTO memory_links (source_id, target_id, link_type, strength, reason) \
+             VALUES (?, ?, 'builds_upon', 0.9, 'silently dropped')",
+            params![source.to_string(), target.to_string()],
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            scalar_i64(&store, "SELECT COUNT(*) FROM memory_links").await,
+            0,
+            "the old CHECK should have dropped this edge"
+        );
+
+        store.run_migrations(false).await.unwrap();
+
+        let ddl = table_ddl(&store).await;
+        assert!(
+            ddl.contains("'builds_upon'"),
+            "CHECK was not widened: {ddl}"
+        );
+        assert!(
+            ddl.contains("UNIQUE(source_id, target_id, link_type)"),
+            "UNIQUE clause lost: {ddl}"
+        );
+        assert!(
+            ddl.contains("DEFAULT CURRENT_TIMESTAMP"),
+            "rebuild lost column defaults: {ddl}"
+        );
+
+        // The previously illegal type is now writable; the duplicate is still refused.
+        conn.execute(
+            "INSERT INTO memory_links (source_id, target_id, link_type, strength) \
+             VALUES (?, ?, 'clarifies', 0.7)",
+            params![source.to_string(), target.to_string()],
+        )
+        .await
+        .expect("clarifies should be writable after the repair");
+        assert!(
+            conn.execute(
+                "INSERT INTO memory_links (source_id, target_id, link_type, strength) \
+                 VALUES (?, ?, 'clarifies', 0.7)",
+                params![source.to_string(), target.to_string()],
+            )
+            .await
+            .is_err(),
+            "UNIQUE(source_id, target_id, link_type) was lost"
+        );
+
+        // Defaults survived the rebuild: omitting them must not yield NULL, which is
+        // what a CREATE TABLE ... AS SELECT rebuild would have done.
+        conn.execute(
+            "INSERT INTO memory_links (source_id, target_id, link_type) \
+             VALUES (?, ?, 'referenced_by')",
+            params![target.to_string(), source.to_string()],
+        )
+        .await
+        .unwrap();
+        let mut rows = conn
+            .query(
+                "SELECT strength, created_at FROM memory_links WHERE link_type = 'referenced_by'",
+                params![],
+            )
+            .await
+            .unwrap();
+        let row = rows.next().await.unwrap().unwrap();
+        let strength: f64 = row.get(0).unwrap();
+        let created_at: String = row.get(1).unwrap();
+        assert!(
+            (strength - 0.5).abs() < f64::EPSILON,
+            "strength default lost"
+        );
+        assert!(!created_at.is_empty(), "created_at default lost");
+
+        // Idempotent, and the indexes were recreated.
+        store.run_migrations(false).await.unwrap();
+        assert!(table_ddl(&store).await.contains("'builds_upon'"));
+        assert!(
+            scalar_i64(
+                &store,
+                "SELECT COUNT(*) FROM sqlite_master WHERE type = 'index' \
+                     AND tbl_name = 'memory_links' AND sql IS NOT NULL"
+            )
+            .await
+                >= 2,
+            "indexes were not recreated"
+        );
+    }
+}
